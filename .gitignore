# =============================================================================
# ESP-IDF build output
# =============================================================================
# Regenerated by `idf.py build`. The CMake cache bakes in absolute paths, so
# these files are not portable between machines and must never be committed.
build/
build-host/

# Generated on first build. Committing it pins one machine's configuration
# onto every other machine.
sdkconfig
sdkconfig.old

# Fetched by the IDF component manager; restored by `idf.py reconfigure`.
managed_components/
dependencies.lock

# =============================================================================
# Secrets - never commit
# =============================================================================
# Wi-Fi credentials, MQTT broker address, and the ESP-NOW shared key.
# Each node ships a committed secrets.h.example template; the real file is not.
secrets.h
.env
*.pem
*.key

# =============================================================================
# Platform (Flask + SQLite)
# =============================================================================
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
*.db
# SQLite write-ahead log, created next to the .db while the platform runs.
*.db-wal
*.db-shm
*.sqlite
*.log

# =============================================================================
# Editor / OS
# =============================================================================
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db