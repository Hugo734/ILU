#pragma once
// Copy this file to secrets.h (same directory) and fill in real values.
// secrets.h is in .gitignore and must never be committed -- see docs/decisions.md.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Public test broker for Wokwi simulation; point at your local Mosquitto's LAN IP when running
// with real hardware on your own network instead.
#define MQTT_BROKER_HOST "broker.hivemq.com"
#define MQTT_BROKER_PORT 1883

// Must be identical across Node A, Node B, the dashboard, and the logger. Not a secret by itself
// (it's collision-avoidance on a broker other people also use) -- HMAC_SHARED_SECRET below is
// what actually prevents forged messages. Pick something short and specific to you.
#define TOPIC_PREFIX "hdc-gh-7f3a"

// Shared secret for HMAC message signing (docs/protocol.md "Message validation"). Must match
// across both nodes and any tooling (logger, dashboard) that needs to verify signatures.
#define HMAC_SHARED_SECRET "change-me-shared-secret"
